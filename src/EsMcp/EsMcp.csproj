<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>es-mcp</AssemblyName>
    <RootNamespace>EsMcp</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EsSdk\EsSdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ships next to the exe. DllResolver checks EVERYTHING_SDK_PATH first, then the app folder. -->
    <Content Include="..\..\third_party\Everything64.dll"
             Link="Everything64.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EsMcp.Tests" />
  </ItemGroup>

</Project>
